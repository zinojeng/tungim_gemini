# =============================================================================
# tungim-gemini / MedNote AI — environment variable template
# =============================================================================
# Copy to `.env` (local) or set these in the Zeabur service's Environment tab.
# NEVER commit real secrets — only this template is tracked (.env* is ignored).
#
# Deploy facts:
#   - Dockerfile: ./Dockerfile (repo root), multi-stage, listens on PORT 3000
#   - Build needs ~2GB RAM (NODE_OPTIONS heap cap is set in the Dockerfile)
#   - Branch: main
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — without these the server will not boot and the whole site 502s.
# A failed server migration most often drops DATABASE_URL — check this first.
# -----------------------------------------------------------------------------

# Postgres connection string. On Zeabur, use the DB service's connection URL.
# Internal (same project, no SSL): postgres://user:pass@<service>.zeabur.internal:5432/db
# External (needs SSL):            postgres://user:pass@host:port/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medinote

# Auth.js / NextAuth signing secret. Generate with: openssl rand -hex 32
# The code reads BOTH names — set both to the SAME value.
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public base URL of the deployment (no trailing slash).
# The code reads BOTH names — set both.
AUTH_URL=https://mednote.zeabur.app
NEXTAUTH_URL=https://mednote.zeabur.app

# -----------------------------------------------------------------------------
# Public site URLs (used in metadata / absolute links)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mednote.zeabur.app
NEXT_PUBLIC_APP_URL=https://mednote.zeabur.app

# -----------------------------------------------------------------------------
# Ingest API (uploader → /api/ingest/*). Bearer token for write access.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
INGEST_API_TOKEN=
# Optional — per-file upload cap in MB (default 50)
INGEST_MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------
# S3-compatible object storage (slide images / assets)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL assets are served from (CDN / bucket public URL)
S3_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Google — OAuth login, Generative AI, and Drive backup
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Email (verification / password reset) + content fetch
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="MedNote AI <noreply@yourdomain.com>"
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Legacy admin password gate (bridged to API auth)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_PASSWORD=
PASSWORD=

# -----------------------------------------------------------------------------
# NODE_ENV is set to "production" automatically by Docker/Zeabur — do not set.
# -----------------------------------------------------------------------------
